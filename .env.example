# Copy to .env at the repo root. Both apps read it.
DATABASE_URL="postgresql://orders:orders@localhost:5433/orders?schema=public"

# Must be set, or the API refuses to boot. Generate: openssl rand -base64 48
JWT_SECRET="replace-me-with-a-long-random-string-at-least-32-chars"
JWT_EXPIRES_IN="8h"

API_PORT=3000
NODE_ENV=development

# Origin allowed to send credentialed requests to the API.
WEB_ORIGIN="http://localhost:5180"
